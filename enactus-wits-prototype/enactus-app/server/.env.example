# ============================================================
# ENACTUS WITS SUPPORT SYSTEM — Backend (Render) Environment Variables
# Set these in your Render service → Environment tab.
# NEVER commit your .env file to Git.
# ============================================================

# ── Resend (Email Delivery) ──────────────────────────────
# Get from: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address: use onboarding@resend.dev for testing,
# or notifications@yourdomain.com once domain is verified
SENDER_EMAIL=onboarding@resend.dev

# ── Supabase Admin Client ────────────────────────────────
# IMPORTANT: Use the service_role key here (NOT the anon key)
# Get from: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Server Port ──────────────────────────────────────────
# Render sets PORT automatically — leave as 5000 for local dev
PORT=5000
